{
  "name": "Smart Meeting Room Booking System",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Smart Room Web App",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install && npx prisma db push && npm run db:seed",
  "customizations": {
    "vscode": {
      "extensions": [
        "Prisma.prisma",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
